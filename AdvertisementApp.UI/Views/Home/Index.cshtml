@model List<AdvertisementApp.Dtos.ProvidedServiceDtos.ProvidedServiceListDto>

<style>
    /* --- SAYFA BAŞLIĞI --- */
    .page-header {
        text-align: center;
        margin-bottom: 50px;
        padding-top: 20px;
    }

    .page-title {
        font-size: 3em;
        font-weight: 900;
        margin-bottom: 10px;
        /* MINT GROWTH GRADIENT TEXT */
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
    }

    .page-subtitle {
        color: #7f8c8d;
        font-size: 1.2em;
    }

    /* --- IZGARA YAPISI --- */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 35px;
    }

    /* --- KART TASARIMI --- */
    .service-card {
        background: white;
        border-radius: 20px;
        padding: 35px 25px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(0,0,0,0.02);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        z-index: 1;
    }

    .service-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
        background: linear-gradient(90deg, #11998e, #38ef7d);
        transition: height 0.3s ease;
        z-index: -1;
    }

    .service-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 20px 40px rgba(17, 153, 142, 0.15);
    }

    .service-card:hover::before {
        height: 100%;
        opacity: 0.05;
    }

    .service-icon-placeholder {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, rgba(17, 153, 142, 0.1), rgba(56, 239, 125, 0.1));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        color: #11998e;
        font-size: 1.5em;
        font-weight: bold;
    }

    /* --- BOŞ SAYFA TASARIMI --- */
    .empty-state {
        text-align: center;
        padding: 70px 30px;
        background: white;
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
        max-width: 650px;
        margin: 20px auto;
        border: 2px dashed #dfe6e9;
    }

    .floating-emoji {
        font-size: 4em;
        display: inline-block;
        margin-bottom: 15px;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
    }

    /* --- BUTON TASARIMI --- */
    .btn-add {
        display: inline-block;
        padding: 15px 35px;
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        text-decoration: none;
        font-weight: bold;
        font-size: 1.1em;
        border-radius: 50px;
        box-shadow: 0 10px 20px rgba(17, 153, 142, 0.3);
        transition: all 0.3s ease;
    }

    .btn-add:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 15px 25px rgba(17, 153, 142, 0.4);
        color: white;
    }
</style>

<div class="page-header">
    <h2 class="page-title">Sunduğumuz Hizmetler</h2>
    <p class="page-subtitle">Şirketinizin büyümesine yardımcı olacak çözümler.</p>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="services-grid">
        @foreach (var item in Model)
        {
            <div class="service-card">
                <div class="service-icon-placeholder">
                    @(item.ImagePath ?? item.Title.Substring(0,1).ToUpper())
                </div>
                <h3>@item.Title</h3>
                <p>@item.Description</p>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <span class="floating-emoji">🚀</span>
        <h3>Buralar Çok Issız...</h3>
        <p>Henüz bir hizmet eklenmemiş. İlk hizmeti ekleyerek bu sayfayı canlandırın!</p>
        <a href="/ProvidedServices/Create" class="btn-add">✨ İlk Hizmeti Ekle</a>
    </div>
}