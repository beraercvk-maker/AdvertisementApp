@model List<AdvertisementApp.Dtos.ProvidedServiceDtos.ProvidedServiceListDto>

<section class="px-margin-mobile md:px-margin-tablet lg:px-margin-desktop max-w-container-max mx-auto py-20 text-center">
    <h1 class="font-display-hero text-headline-lg-mobile md:text-display-hero tracking-tighter mb-8 bg-gradient-to-r from-on-surface to-outline-variant bg-clip-text text-transparent">
        CRAFTING<br/>NEW REALITIES
    </h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        We blend high-end visual aesthetics with data-driven strategic thinking to propel brands into the digital stratosphere.
    </p>
</section>

<section class="px-margin-mobile md:px-margin-tablet lg:px-margin-desktop max-w-container-max mx-auto pb-section-gap">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
        
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <div class="glass-card rounded-xl p-8 flex flex-col justify-between group h-[400px]">
                    <div>
                        <div class="w-12 h-12 rounded-lg bg-tertiary/10 flex items-center justify-center mb-6 group-hover:bg-tertiary/20 transition-colors">
                            <span class="material-symbols-outlined text-tertiary text-3xl" data-icon="insights">insights</span>
                        </div>
                        <h3 class="font-headline-md text-headline-md text-on-surface mb-4">@item.Title</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant">@item.Description</p>
                    </div>
                    <a class="font-label-caps text-label-caps text-tertiary flex items-center gap-2 mt-auto" href="#">
                        Learn More <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-span-full glass-card rounded-xl p-8 text-center">
                <h3 class="font-headline-md text-headline-md text-on-surface mb-4">No Services Yet</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mb-6">Start by adding your first service to the platform.</p>
                <a href="/ProvidedServices/Create" class="bloom-button px-8 py-3 rounded-full text-white inline-block font-label-caps">ADD SERVICE</a>
            </div>
        }

    </div>
</section>

<section class="py-20 border-y border-outline-variant/10 overflow-hidden bg-surface-container-lowest">
    <div class="flex whitespace-nowrap animate-marquee">
        <div class="flex items-center gap-20 px-10">
            <span class="font-display-hero text-headline-lg opacity-10 uppercase italic">Innovation</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase">Identity</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase italic">Digital Prestige</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase">Motion</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase italic">Strategy</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase">Fluidity</span>
        </div>
        <div class="flex items-center gap-20 px-10">
            <span class="font-display-hero text-headline-lg opacity-10 uppercase italic">Innovation</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase">Identity</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase italic">Digital Prestige</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase">Motion</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase italic">Strategy</span>
            <span class="font-display-hero text-headline-lg opacity-10 uppercase">Fluidity</span>
        </div>
    </div>
</section>

<section class="px-margin-mobile md:px-margin-tablet lg:px-margin-desktop max-w-container-max mx-auto py-section-gap">
    <div class="relative overflow-hidden rounded-3xl p-12 md:p-24 bg-surface-container-low group">
        <div class="absolute inset-0 opacity-20 group-hover:opacity-30 transition-opacity">
            <img alt="Future Tech" class="w-full h-full object-cover" data-alt="An abstract high-tech digital environment with glowing geometric shapes and fluid neon blue lines moving through a dark, multidimensional space. The lighting is dramatic with intense cyan and purple blooms, creating a futuristic and premium digital prestige aesthetic. The composition is dynamic and wide-angle, suggesting a sense of endless technological advancement and artistic motion." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBUaJZcOGNLzemkWVT6qhigqf50cCI95MUqudLtbg6qRjUS9eexfE9RS2LVgtRobYxHAlXLhNMFhmTW8tNqUjrYFYyq5PNGqj_1TT92C2VkvnEmTr424TDusAB3tXk-jqSzNMqX6OuQgrOSPehCLSm_WmbQXV65Zd0kNDMa2Zpqlm0ofSAr0QQjVqg6E3VkfWg9GUrvTvWEzqu1kHoSPezRXNV68I9qMhkCqmmZ1M0nEkw8SURFZuSQfZSxjPDfyQtRrMDbDbmTgNdz"/>
        </div>
        <div class="relative z-10 max-w-2xl">
            <h2 class="font-headline-lg text-headline-lg text-on-surface mb-8">Ready to define the future?</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant mb-12">Join the elite brands shaping the next generation of digital culture. Let's create something immortal.</p>
            <button class="bloom-button px-10 py-5 rounded-full font-label-caps text-label-caps text-white flex items-center gap-4">
                START A PROJECT <span class="material-symbols-outlined" data-icon="rocket_launch">rocket_launch</span>
            </button>
        </div>
    </div>
</section>