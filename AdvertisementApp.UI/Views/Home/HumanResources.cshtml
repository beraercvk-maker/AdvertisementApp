@model List<AdvertisementApp.Dtos.AdvertisementDtos.AdvertisementListDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Careers";
}
@* <div style="background-color: red; color: white; padding: 20px; text-align: center; font-size: 24px; font-weight: bold; width: 100%; margin-bottom: 30px;">
    SİSTEM TESTİ: Model Durumu = @(Model == null ? "BOMBOŞ (NULL GELDİ)" : Model.Count + " TANE İLAN BULUNDU")
</div> *@
<div class="px-margin-mobile md:px-margin-tablet lg:px-margin-desktop max-w-container-max mx-auto pb-section-gap">
    <div class="flex flex-col md:flex-row justify-between items-start mb-12 border-b border-outline-variant/20 pb-8 pt-8">
        <div class="max-w-2xl">
            <h2 class="font-headline-lg text-4xl md:text-5xl font-black text-on-surface tracking-tighter mb-4 uppercase">
                Join The <span class="text-transparent bg-clip-text bg-gradient-to-r from-tertiary to-secondary">Collective</span>
            </h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant">
                We are always looking for visionary talents to shape the future of digital experiences. Build the next generation of applications with us.
            </p>
        </div>
        <a href="#" class="mt-6 md:mt-0 font-label-caps text-label-caps text-tertiary border border-tertiary/30 px-8 py-4 rounded-full hover:bg-tertiary hover:text-background transition-all flex items-center gap-2">
            VIEW ALL ROLES <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
    @if (Model != null && Model.Count > 0)
    {

   
    @foreach (var   item in Model)
    {
        <div class="glass-card rounded-xl p-8 group cursor-pointer flex flex-col justify-between h-[300px]">
            <div>
                <div class="flex justify-between items-center mb-6">
                    <span class="font-label-caps text-[11px] text-tertiary border border-tertiary/30 px-3 py-1 rounded-full tracking-widest">
                        ANKARA / HYBRID
                    </span>
                    <span class="material-symbols-outlined text-on-surface-variant group-hover:text-tertiary transition-colors duration-300 transform group-hover:translate-x-1 group-hover:-translate-y-1">north_east</span>
                </div>
                
                <h3 class="font-headline-md text-2xl font-bold text-on-surface mb-3">@item.Title</h3>
                
                <p class="font-body-md text-on-surface-variant mb-6 text-sm">
                    @item.Description
                </p>
            </div>
            
            <p class="font-label-caps text-xs text-outline-variant mt-4">
                EKLENME TARİHİ: @item.CreatedDate.ToString("dd MMM yyyy")
            </p>
        </div>
    }

     }

</div>
</div>