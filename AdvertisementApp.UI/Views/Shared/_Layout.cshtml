    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }
        .glass-card:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(0, 221, 221, 0.4);
            transform: translateY(-8px);
            box-shadow: 0 0 30px rgba(0, 221, 221, 0.15);
        }
        .mesh-gradient {
            background: radial-gradient(at 0% 0%, rgba(119, 1, 208, 0.15) 0px, transparent 50%),
                        radial-gradient(at 100% 100%, rgba(0, 221, 221, 0.15) 0px, transparent 50%);
        }
        .bloom-button {
            background: linear-gradient(135deg, #7701d0 0%, #00dddd 100%);
            transition: all 0.3s ease;
        }
        .bloom-button:hover {
            box-shadow: 0 0 20px rgba(0, 221, 221, 0.5);
            transform: scale(1.05);
        }
        @@keyframes marquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .animate-marquee {
            animation: marquee 30s linear infinite;
        }
        body {
            min-height: max(884px, 100dvh);
            display: flex;
            flex-direction: column;
        }
    </style>
</head>
<body class="bg-background text-on-background selection:bg-tertiary selection:text-on-tertiary overflow-x-hidden">

    <header class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-outline-variant/20 shadow-[0_0_20px_rgba(0,221,221,0.1)]">
        <nav class="flex justify-between items-center px-margin-mobile md:px-margin-tablet lg:px-margin-desktop py-6 max-w-container-max mx-auto">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-tertiary" data-icon="bubble_chart">bubble_chart</span>
                <span class="font-headline-md text-headline-md font-black tracking-tighter text-on-surface dark:text-on-surface">KINETIC NOIR</span>
            </div>
            <div class="hidden md:flex items-center gap-10">
    <a class="font-label-caps text-label-caps text-on-surface hover:text-tertiary transition-colors duration-300" 
       asp-controller="Home" asp-action="Index">Work</a>
    
    <a class="font-label-caps text-label-caps text-tertiary relative after:content-[''] after:absolute after:-bottom-1 after:left-0 after:w-full after:h-0.5 after:bg-tertiary" 
       asp-controller="Home" asp-action="Index">Services</a>
    
    <a class="font-label-caps text-label-caps text-on-surface hover:text-tertiary transition-colors duration-300" 
       href="#">Vision</a>
    
    <a class="font-label-caps text-label-caps text-on-surface hover:text-tertiary transition-colors duration-300" 
       asp-controller="Home" asp-action="HumanResources">Human Resources</a>
</div>

<a asp-controller="ProvidedServices" asp-action="Create" class="font-label-caps text-label-caps text-tertiary hover:scale-105 transition-transform duration-300 border border-tertiary/30 px-6 py-2 rounded-full cursor-pointer">
    LET'S TALK
</a>
            
        </nav>
    </header>

    <main class="mesh-gradient pt-[120px] flex-grow">
        @RenderBody()
    </main>

    <footer class="w-full py-section-gap bg-surface-container-lowest border-t border-outline-variant/10 mt-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:flex lg:justify-between px-margin-mobile md:px-margin-tablet lg:px-margin-desktop gap-gutter max-w-container-max mx-auto">
            <div>
                <p class="font-headline-lg text-headline-lg font-bold text-on-surface mb-4">KINETIC NOIR</p>
                <p class="font-body-md text-body-md text-on-surface-variant">© 2024 KINETIC NOIR. ART IN MOTION.</p>
            </div>
            <div class="flex flex-col gap-4">
                <h4 class="font-label-caps text-label-caps text-secondary">EXPLORE</h4>
                <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors hover:translate-x-1 transition-transform duration-200" href="#">Work</a>
                <a class="font-body-md text-body-md text-tertiary" href="#">Services</a>
                <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors hover:translate-x-1 transition-transform duration-200" href="#">Vision</a>
                <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors hover:translate-x-1 transition-transform duration-200" href="#">Human Resources</a>
                <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors hover:translate-x-1 transition-transform duration-200" href="#">Contact</a>
            </div>
            <div class="flex flex-col gap-4">
                <h4 class="font-label-caps text-label-caps text-secondary">SOCIAL</h4>
                <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#">Instagram</a>
                <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#">LinkedIn</a>
                <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#">Behance</a>
                <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#">Twitter</a>
            </div>
            <div class="max-w-[300px]">
                <h4 class="font-label-caps text-label-caps text-secondary mb-4">NEWSLETTER</h4>
                <div class="flex border-b border-outline-variant py-2 focus-within:ring-2 ring-tertiary transition-all">
                    <input class="bg-transparent border-none focus:ring-0 text-on-surface w-full font-body-md" placeholder="Email Address" type="email"/>
                    <button class="material-symbols-outlined text-tertiary" data-icon="north_east">north_east</button>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>