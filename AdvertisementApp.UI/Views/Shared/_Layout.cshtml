<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Services | KINETIC NOIR</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;900&family=Space+Grotesk:wght@600&family=Inter:wght@400&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "surface-container-low": "#191c1d",
                    "on-secondary": "#480081",
                    "on-error-container": "#ffdad6",
                    "on-background": "#e1e3e4",
                    "tertiary": "#00dddd",
                    "inverse-primary": "#5f5e5e",
                    "surface-variant": "#323536",
                    "on-secondary-fixed-variant": "#6700b5",
                    "inverse-surface": "#e1e3e4",
                    "on-error": "#690005",
                    "primary-fixed-dim": "#c8c6c5",
                    "on-surface-variant": "#c4c7c7",
                    "surface-bright": "#373a3b",
                    "on-primary": "#313030",
                    "error": "#ffb4ab",
                    "background": "#111415",
                    "secondary": "#dcb8ff",
                    "on-primary-container": "#7e7d7d",
                    "on-tertiary-container": "#008c8c",
                    "primary": "#c8c6c5",
                    "error-container": "#93000a",
                    "on-tertiary-fixed": "#002020",
                    "tertiary-container": "#001515",
                    "primary-fixed": "#e5e2e1",
                    "secondary-fixed": "#efdbff",
                    "on-tertiary-fixed-variant": "#004f4f",
                    "surface-dim": "#111415",
                    "secondary-container": "#7701d0",
                    "on-secondary-container": "#dcb7ff",
                    "outline-variant": "#444748",
                    "surface-container-lowest": "#0c0f10",
                    "surface": "#111415",
                    "surface-container": "#1d2021",
                    "on-primary-fixed": "#1c1b1b",
                    "on-secondary-fixed": "#2c0051",
                    "tertiary-fixed": "#00fbfb",
                    "primary-container": "#121212",
                    "surface-container-high": "#282a2b",
                    "on-primary-fixed-variant": "#474646",
                    "surface-tint": "#c8c6c5",
                    "outline": "#8e9192",
                    "tertiary-fixed-dim": "#00dddd",
                    "surface-container-highest": "#323536",
                    "secondary-fixed-dim": "#dcb8ff",
                    "on-surface": "#e1e3e4",
                    "on-tertiary": "#003737",
                    "inverse-on-surface": "#2e3132"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "margin-desktop": "80px",
                    "margin-tablet": "40px",
                    "gutter": "32px",
                    "margin-mobile": "20px",
                    "section-gap": "160px",
                    "unit": "8px",
                    "container-max": "1440px"
            },
            "fontFamily": {
                    "headline-md": ["Montserrat"],
                    "label-caps": ["Space Grotesk"],
                    "body-md": ["Inter"],
                    "headline-lg-mobile": ["Montserrat"],
                    "body-lg": ["Inter"],
                    "display-hero": ["Montserrat"],
                    "headline-lg": ["Montserrat"]
            },
            "fontSize": {
                    "headline-md": ["32px", {"lineHeight": "130%", "fontWeight": "600"}],
                    "label-caps": ["14px", {"lineHeight": "100%", "letterSpacing": "0.15em", "fontWeight": "600"}],
                    "body-md": ["16px", {"lineHeight": "150%", "fontWeight": "400"}],
                    "headline-lg-mobile": ["42px", {"lineHeight": "115%", "letterSpacing": "0.02em", "fontWeight": "700"}],
                    "body-lg": ["18px", {"lineHeight": "160%", "fontWeight": "400"}],
