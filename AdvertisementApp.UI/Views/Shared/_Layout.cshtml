<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reklam Uygulaması</title>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            margin: 0; 
            padding: 0; 
            background-color: #f8f9fa;
            display: flex; 
            flex-direction: column; 
            min-height: 100vh;
        }

        /* --- NAVBAR TASARIMI (MINT GROWTH) --- */
        .navbar { 
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); 
            padding: 15px 40px; 
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 15px rgba(17, 153, 142, 0.2);
        }
        .navbar-brand {
            color: white;
            font-size: 1.5em;
            font-weight: 800;
            text-decoration: none;
            letter-spacing: 1px;
        }
        .navbar-links a { 
            color: rgba(255,255,255,0.9); 
            text-decoration: none; 
            margin-left: 15px; 
            font-weight: 600; 
            padding: 10px 20px;
            border-radius: 25px;
            transition: all 0.3s ease;
        }
        .navbar-links a:hover { 
            color: #11998e; 
            background-color: white; 
            box-shadow: 0 4px 10px rgba(255,255,255,0.3);
        }

        .container { 
            padding: 40px 20px; 
            max-width: 1200px; 
            margin: 0 auto; 
            flex: 1;
            width: 100%;
            box-sizing: border-box;
        }

        .footer { 
            background-color: #2c3e50;
            color: #ecf0f1; 
            text-align: center; 
            padding: 20px; 
        }
    </style>
</head>
<body>

    <div class="navbar">
        <a href="/" class="navbar-brand">AppLogo✨</a>
        <div class="navbar-links">
            <a href="/">Ana Sayfa</a>
            <a href="/ProvidedServices/Create">Hizmet Ekle</a>
        </div>
    </div>

    <div class="container">
        @RenderBody()
    </div>

    <div class="footer">
        <p style="margin: 0;">&copy; 2026 Advertisement App. Tüm Hakları Saklıdır.</p>
    </div>

</body>
</html>