@model AdvertisementApp.UI.Models.UserLoginModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Giriş Yap";
}

@* Sayfa genelini ortalayan ana kapsayıcı *@
<div class="min-h-[80vh] flex items-center justify-center py-10 px-4">
    
    @* Glassmorphism Kart Tasarımı *@
    <div class="glass-card w-full max-w-lg rounded-[2rem] p-8 md:p-12 border border-white/20 shadow-2xl backdrop-blur-md bg-white/5">
        
        @* Başlık Bölümü *@
        <div class="text-center mb-10">
            <h2 class="text-3xl font-black text-white uppercase tracking-tighter mb-2">
                Tekrar <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500">Hoş Geldin</span>
            </h2>
            <p class="text-gray-400 text-sm font-medium">Hesabınıza giriş yaparak devam edin.</p>
        </div>

        @* Giriş Formu *@
        <form asp-action="SignIn" asp-controller="Account" method="post" class="space-y-5">
            
            @* Genel Hata Mesajları (Örn: Yanlış şifre) *@
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm text-center font-bold mb-2"></div>

            @* Kullanıcı Adı *@
            <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 ml-2 uppercase">Kullanıcı Adı</label>
                <input asp-for="Username" placeholder="Kullanıcı adınızı giriniz" 
                       class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder:text-gray-600 focus:outline-none focus:border-blue-500 transition-all" />
                <span asp-validation-for="Username" class="text-red-500 text-[10px] ml-2 font-medium"></span>
            </div>

            @* Şifre *@
            <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 ml-2 uppercase">Şifre</label>
                <input asp-for="Password" type="password" placeholder="••••••••" 
                       class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder:text-gray-600 focus:outline-none focus:border-blue-500 transition-all" />
                <span asp-validation-for="Password" class="text-red-500 text-[10px] ml-2 font-medium"></span>
            </div>

            @* Beni Hatırla (Checkbox Tasarımı) *@
            <div class="flex items-center ml-2 pt-1">
                <input asp-for="RememberMe" class="w-4 h-4 text-blue-600 bg-white/5 border border-white/10 rounded focus:ring-blue-500 focus:ring-2 cursor-pointer" />
                <label asp-for="RememberMe" class="ml-2 text-sm font-medium text-gray-400 cursor-pointer select-none">
                    Beni Hatırla
                </label>
            </div>

            @* Giriş Butonu *@
            <div class="pt-4">
                <button type="submit" 
                        class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold py-4 rounded-xl hover:scale-[1.02] active:scale-95 transition-all shadow-lg shadow-blue-500/20 uppercase tracking-widest text-sm">
                    Sisteme Giriş Yap
                </button>
            </div>
        </form>

        @* Alt Bilgi (Kayıt Ol Sayfasına Yönlendirme) *@
        <div class="mt-8 text-center">
            <p class="text-gray-500 text-xs">
                Henüz bir hesabın yok mu? 
                <a asp-action="SignUp" asp-controller="Account" class="text-blue-400 font-bold hover:underline transition-all">
                    Hemen Kayıt Ol
                </a>
            </p>
        </div>

    </div>
</div>

@* İstemci taraflı validasyon *@
@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}